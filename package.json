{
  "name": "promptshield",
  "version": "1.0.0",
  "description": "Universal security scanner for AI coding assistants (IBM Bob, Claude Code, Cursor)",
  "author": "Harsha Satyavardhan",
  "license": "MIT",
  "keywords": [
    "security",
    "mcp",
    "ibm-bob",
    "claude-code",
    "cursor",
    "sarif"
  ],
  "homepage": "https://github.com/HarshaSatyavardhan/bb#readme",
  "bugs": {
    "url": "https://github.com/HarshaSatyavardhan/bb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshaSatyavardhan/bb.git"
  },
  "type": "module",
  "bin": {
    "promptshield": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src/signatures/signatures.json",
    "skills",
    "modes",
    "docs",
