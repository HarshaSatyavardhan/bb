{
  "name": "promptshield",
  "version": "1.0.0",
  "description": "Universal security scanner for AI coding assistants (IBM Bob, Claude Code, Cursor)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "promptshield": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src/signatures/signatures.json",
    "skills",
    "modes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.1.0",
    "consola": "^3.2.3",
    "fast-glob": "^3.3.2",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "execa": "^9.5.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
